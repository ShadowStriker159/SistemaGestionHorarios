<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="https://jakarta.ee/xml/ns/jakartaee"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                           https://jakarta.ee/xml/ns/jakartaee/beans_4_0.xsd"
       version="4.0"
       bean-discovery-mode="all">
  <!--
    WildFly 37 trae CDI 4.0 nativamente (Weld 5.x integrado).
    Con bean-discovery-mode="all" WildFly escanea todos los beans
    sin necesidad de añadir Weld como dependencia en el pom.xml.
    NUNCA agregues weld-servlet-shaded al pom cuando despliegas en WildFly.
  -->
</beans>
