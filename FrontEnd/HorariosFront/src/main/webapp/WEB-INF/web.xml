<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                             https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         id="WebApp_ID" version="6.0">

  <display-name>HorariosFront</display-name>

  <filter>
    <filter-name>AutorizacionFilter</filter-name>
    <filter-class>co.edu.unbosque.util.AutorizacionFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>AutorizacionFilter</filter-name>
    <url-pattern>*.xhtml</url-pattern>
  </filter-mapping>

  <!-- ============================================================
       JSF FacesServlet
       WildFly 37 ya registra el FacesServlet automáticamente si
       hay un faces-config.xml o un beans.xml presente, pero lo
       declaramos explícitamente para mayor control.
       ============================================================ -->
  <servlet>
    <servlet-name>FacesServlet</servlet-name>
    <servlet-class>jakarta.faces.webapp.FacesServlet</servlet-class>
    <load-on-startup>1</load-on-startup>
  </servlet>
  <servlet-mapping>
    <servlet-name>FacesServlet</servlet-name>
    <url-pattern>*.xhtml</url-pattern>
  </servlet-mapping>

  <!-- ============================================================
       Parámetros de contexto JSF
       ============================================================ -->
  <context-param>
    <param-name>jakarta.faces.PROJECT_STAGE</param-name>
    <param-value>Development</param-value>
  </context-param>

  <!-- Necesario para PrimeFaces file upload en WildFly -->
  <context-param>
    <param-name>jakarta.faces.FACELETS_SKIP_COMMENTS</param-name>
    <param-value>true</param-value>
  </context-param>

  <!-- PrimeFaces: tema visual -->
  <context-param>
    <param-name>primefaces.THEME</param-name>
    <param-value>saga</param-value>
  </context-param>

  <!-- ============================================================
       Página de bienvenida
       ============================================================ -->
  <welcome-file-list>
    <welcome-file>index.xhtml</welcome-file>
  </welcome-file-list>

</web-app>