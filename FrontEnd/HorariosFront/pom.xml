<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>HorariosFront</groupId>
	<artifactId>HorariosFront</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>war</packaging>

	<properties>
		<maven.compiler.source>22</maven.compiler.source>
		<maven.compiler.target>22</maven.compiler.target>
		<!-- WildFly 37 incluye Jakarta EE 10 internamente -->
	</properties>

	<dependencies>

		<!-- ============================================================
		     Jakarta EE 10 — WildFly 37 lo provee en runtime.
		     Solo necesitamos las APIs para compilar (provided).
		     ============================================================ -->
		<dependency>
			<groupId>jakarta.platform</groupId>
			<artifactId>jakarta.jakartaee-api</artifactId>
			<version>10.0.0</version>
			<scope>provided</scope>
		</dependency>

		<!-- ============================================================
		     PrimeFaces 13 (jakarta) — se despliega DENTRO del WAR
		     porque WildFly no lo trae incluido.
		     ============================================================ -->
		<dependency>
			<groupId>org.primefaces</groupId>
			<artifactId>primefaces</artifactId>
			<version>14.0.0</version>
			<classifier>jakarta</classifier>
		</dependency>

		<!-- PrimeFlex para el layout CSS de PrimeFaces -->
		<dependency>
			<groupId>org.webjars.npm</groupId>
			<artifactId>primeflex</artifactId>
			<version>3.3.1</version>
		</dependency>

		<!-- ============================================================
		     Gson — para deserializar respuestas JSON del backend REST
		     ============================================================ -->
		<dependency>
			<groupId>com.google.code.gson</groupId>
			<artifactId>gson</artifactId>
			<version>2.10.1</version>
		</dependency>

		<!-- Test -->
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<version>4.13.2</version>
			<scope>test</scope>
		</dependency>

	</dependencies>

	<build>
		<plugins>
			<plugin>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.11.0</version>
				<configuration>
					<!-- Java 17 es el target: WildFly 37 corre en Java 17+
					     y es el LTS más compatible. El código fuente puede
					     compilar con Java 22 localmente. -->
					<release>22</release>
				</configuration>
			</plugin>
			<plugin>
				<artifactId>maven-war-plugin</artifactId>
				<version>3.4.0</version>
				<configuration>
					<!-- WildFly no necesita web.xml mínimo si usamos
					anotaciones,
					     pero lo mantenemos para el FacesServlet -->
					<failOnMissingWebXml>false</failOnMissingWebXml>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>